# generated by fjs from src/pages and the modules
**/src/fjs-routes.d.ts
**/src/fjs-modules.d.ts
**/src/fjs-components.d.ts
**/src/fjs-assets.d.ts

# an fjs module's Flutter package: build state, not source
packages/*/flutter/pubspec.lock
packages/*/flutter/.flutter-plugins
packages/*/flutter/.flutter-plugins-dependencies
.zcode/

.flutter-plugins-dependencies

# VitePress (website/)
**/.vitepress/cache


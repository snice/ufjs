{
  "app": {
    // Signing is per developer (spec 110): DevEco's "Automatically generate
    // signature" writes this developer's certificate paths and locally
    // encrypted passwords here, which no one else can use. Kept empty in
    // git — see examples/fjs-go/README.md for signing a local build.
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.0.5(17)",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
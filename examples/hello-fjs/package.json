{
  "name": "hello-fjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fjs dev",
    "dev:pages": "fjs dev --pages",
    "dev:web": "vite --host 0.0.0.0",
    "dev:web:fjs": "fjs dev --web",
    "build": "fjs build",
    "build:bytecode": "fjs build --bytecode",
    "build:pages": "fjs build --pages",
    "build:pages:bytecode": "fjs build --pages --bytecode",
    "build:web": "vite build",
    "build:web:fjs": "fjs build --web",
    "build:release": "fjs build --pages --release",
    "build:apk": "fjs build --pages --release --apk",
    "run:android": "fjs run android",
    "run:ios": "fjs run ios",
    "typecheck": "vue-tsc --noEmit",
    "build:mp": "fjs build --mp",
    "dev:mp": "fjs dev --mp"
  },
  "dependencies": {
    "@antv/f2": "^5.14.0",
    "@leafer-ui/miniapp": "2.2.10",
    "@ufjs/iconmind": "workspace:*",
    "@ufjs/spine": "workspace:*",
    "@ufjs/webgl": "workspace:*",
    "@ufjs/webview": "workspace:*",
    "@vueuse/motion": "^3.0.3",
    "animejs": "4.5.0",
    "echarts": "^6.1.0",
    "pixi.js": "^7.4.3",
    "three": "0.170.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "@ufjs/cli": "workspace:*",
    "@ufjs/runtime": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/runtime-core": "^3.5.42",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  },
  "fjs": {
    "mp": {
      "subpackages": [
        {
          "root": "game",
          "pages": ["example/game/"],
          "public": ["wm", "fb"]
        },
        {
          "root": "canvas",
          "pages": ["example/canvas/", "example/animation/"],
          "public": ["spine"]
        }
      ],
      "preloadRule": {
        "/example": { "network": "all", "packages": ["game", "canvas"] }
      },
      "exclude": [
        "example/canvas/echarts",
        "example/canvas/webgl-instanced",
        "example/canvas/gltf-viewer",
        "example/canvas/three-gltf",
        "example/interaction/theme",
        "example/game/jump",
        "example/game/shooter",
        "example/game/match3",
        "comp/web/",
        "comp/feedback/refresh"
      ],
      "excludeComponents": [
        "@/components/TabBar.vue"
      ]
    }
  }
}

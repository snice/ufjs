.pnpm-store
node_modules
dist
build
.dart_tool
.DS_Store
.vscode
.cxx
.fjs
.npmrc
.claude/*
# spec-kit 的 slash 命令要随仓库走（AGENTS.md 引用它们）
!.claude/commands/
# 预览服务器的启动配置也随仓库走：端口/命令是项目的事，不是某台机器的事
!.claude/launch.json
midscene_run

# generated by fjs from src/pages and the modules
**/src/fjs-routes.d.ts
**/src/fjs-modules.d.ts
**/src/fjs-components.d.ts
**/src/fjs-assets.d.ts

# an fjs module's Flutter package: build state, not source
packages/*/flutter/pubspec.lock
# flutter_fjs is a published library: its consumers resolve their own
# versions, so a lockfile here is build state too (spec 110). Its example/
# is an app and keeps its lockfile, like examples/fjs-go.
packages/flutter_fjs/pubspec.lock
packages/*/flutter/.flutter-plugins
packages/*/flutter/.flutter-plugins-dependencies
.zcode/

.flutter-plugins-dependencies

# VitePress (website/)
**/.vitepress/cache

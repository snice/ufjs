{
  "name": "@ufjs/webview",
  "version": "0.1.4",
  "description": "web-view for fjs — one <web-view /> tag, a WKWebView/WebView on the app and an iframe on the web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snice/ufjs.git",
    "directory": "packages/fjs-webview"
  },
  "homepage": "https://github.com/snice/ufjs#readme",
  "bugs": "https://github.com/snice/ufjs/issues",
  "keywords": [
    "fjs",
    "flutter",
    "webview",
    "iframe",
    "vue"
  ],
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./components/*": "./components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "components",
    "flutter/lib",
    "flutter/pubspec.yaml",
    "public",
    "prepare.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ufjs/runtime": ">=0.1.3",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "happy-dom": "^20.12.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  },
  "fjs": {
    "module": true,
    "widgets": {
      "web-view": {
        "web": "./components/WebViewWeb.vue"
      }
    },
    "flutter": {
      "package": "fjs_webview",
      "path": "./flutter",
      "import": "package:fjs_webview/fjs_webview.dart",
      "register": "FjsWebview.register(engine)"
    },
    "prepare": "./prepare.mjs"
  }
}

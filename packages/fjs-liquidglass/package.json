{
  "name": "@ufjs/liquidglass",
  "version": "0.0.1",
  "description": "Liquid Glass for fjs — one <glass-surface /> tag (Flutter shader glass on the app, backdrop-filter + SVG refraction on the web) and switchable tab bar styles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snice/ufjs.git",
    "directory": "packages/fjs-liquidglass"
  },
  "homepage": "https://github.com/snice/ufjs#readme",
  "bugs": "https://github.com/snice/ufjs/issues",
  "keywords": [
    "fjs",
    "flutter",
    "liquid-glass",
    "glassmorphism",
    "tabbar",
    "vue"
  ],
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./components/*": "./components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "slider.ts",
    "components",
    "flutter/lib",
    "flutter/pubspec.yaml",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ufjs/runtime": ">=0.1.3",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "happy-dom": "^20.12.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "3.5.43"
  },
  "fjs": {
    "module": true,
    "components": "components",
    "componentPrefix": "Glass",
    "widgets": {
      "glass-surface": {
        "web": "./components/GlassSurfaceWeb.vue",
        "props": {
          "radius": "number",
          "blur": "number",
          "tint": "string",
          "refraction": "number",
          "dark": "boolean",
          "pressed": "boolean"
        }
      }
    },
    "flutter": {
      "package": "fjs_liquidglass",
      "path": "./flutter",
      "import": "package:fjs_liquidglass/fjs_liquidglass.dart",
      "register": "FjsLiquidglass.register(engine)"
    }
  }
}

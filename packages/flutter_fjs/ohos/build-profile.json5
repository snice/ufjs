{
  // Two prebuilt .so files ship in libs/arm64-v8a (spec 090): libfjs.so is
  // the engine and goes into every build; libfjs_debugger.so is the CDP
  // inspector + transport and must not reach a shipped app. Dart only ever
  // dlopens the module under kDebugMode, so dropping it from every non-debug
  // HAR is exactly the set of builds that could never have used it.
  //
  // This binder only applies when the plugin is assembled as a HAR with
  // `-p buildMode=<mode>`. The ohos flutter fork usually hands plugins to ohpm
  // as `file:` SOURCE dependencies instead, and then this file's binder is
  // never consulted — a 0.1.6 release HAP shipped the module (spec 115). The
  // filter that actually decides is the host's entry/build-profile.json5,
  // which @ufjs/cli patches in managed hosts (patchOhosEntryDebuggerFilter);
  // other hosts add the same fjs_no_debugger option there by hand.
  "apiType": "stageMode",
  "buildOption": {
  },
  "buildOptionSet": [
    {
      "name": "no_debugger",
      "nativeLib": {
        "filter": {
          "excludes": [
            "**/libfjs_debugger.so"
          ]
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    }
  ],
  "buildModeBinder": [
    {
      "buildModeName": "release",
      "mappings": [
        {
          "targetName": "default",
          "buildOptionName": "no_debugger"
        }
      ]
    },
    {
      "buildModeName": "profile",
      "mappings": [
        {
          "targetName": "default",
          "buildOptionName": "no_debugger"
        }
      ]
    }
  ]
}

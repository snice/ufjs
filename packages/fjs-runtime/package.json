{
  "name": "@ufjs/runtime",
  "version": "0.1.7",
  "description": "JS runtime for flutter_fjs: element API, batched UI op protocol, Vue 3 custom renderer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snice/ufjs.git",
    "directory": "packages/fjs-runtime"
  },
  "homepage": "https://github.com/snice/ufjs#readme",
  "bugs": "https://github.com/snice/ufjs/issues",
  "keywords": ["flutter", "javascript", "typescript", "vue", "quickjs", "runtime", "fjs"],
  "type": "module",

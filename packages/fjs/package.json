{
  "name": "@ufjs/cli",
  "version": "0.1.4",
  "description": "Build toolchain for ufjs: bundle TS/JS/Vue SFC apps for the flutter_fjs runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snice/ufjs.git",
    "directory": "packages/fjs"
  },
  "homepage": "https://github.com/snice/ufjs#readme",
  "bugs": "https://github.com/snice/ufjs/issues",
  "keywords": [
    "flutter",
    "javascript",
    "typescript",
    "vue",
    "quickjs",
    "bundler",
    "fjs"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "fjs": "dist/cli.js"
  },
  "exports": {
    "./config": {
      "types": "./types/config.d.ts",
      "default": "./dist/config.js"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/cli.ts src/config.ts src/vite.ts --bundle --platform=node --format=esm --outdir=dist --packages=external",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "@ufjs/fjsc-darwin-arm64": "0.1.4",
    "@ufjs/fjsc-darwin-x64": "0.1.4",
    "@ufjs/fjsc-linux-arm64": "0.1.4",
    "@ufjs/fjsc-linux-x64": "0.1.4",
    "@ufjs/fjsc-win32-x64": "0.1.4"
  },
  "dependencies": {
    "@ufjs/runtime": "^0.1.4",
    "@vue/compiler-core": "^3.4.0",
    "@vue/compiler-sfc": "^3.4.0",
    "@vue/shared": "^3.5.42",
    "esbuild": "^0.23.0",
    "qrcode-generator": "^2.0.4",
    "wawoff2": "^2.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

{
  "name": "@ufjs/webgl",
  "version": "0.1.4",
  "description": "WebGL contexts for fjs canvas — getContext('webgl'/'webgl2') on the app via ANGLE, browser-native on the web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snice/ufjs.git",
    "directory": "packages/fjs-webgl"
  },
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "src",
    "flutter/lib",
    "flutter/pubspec.yaml",
    "flutter/ohos/build-profile.json5",
    "flutter/ohos/hvigorfile.ts",
    "flutter/ohos/index.ets",
    "flutter/ohos/oh-package.json5",
    "flutter/ohos/src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ufjs/runtime": ">=0.1.4"
  },
  "devDependencies": {
    "@ufjs/runtime": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "fjs": {
    "module": true,
    "flutter": {
      "package": "fjs_webgl",
      "path": "./flutter",
      "import": "package:fjs_webgl/fjs_webgl.dart",
      "register": "FjsWebgl.register(engine)"
    }
  }
}

{
  "name": "ufjs",
  "version": "0.1.3",
  "private": true,
  "description": "JS/TS runtime for Flutter apps, with Vue 3 support",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "build": "pnpm --filter @ufjs/cli run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && pnpm run test:hooks",
    "test:hooks": "node --test .githooks/check-commit-msg.test.mjs",
    "build:examples": "pnpm --filter \"./examples/**\" --if-present run build",
    "docs:dev": "pnpm --filter ufjs-website run dev",
    "docs:build": "pnpm --filter ufjs-website run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
